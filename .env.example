# Template for local environment. Copy to `.env` and adjust if needed.
# Never commit the real `.env` — it contains secrets.
# These defaults are safe local-dev values; do NOT reuse them on production.

# Postgres
DB_PASSWORD="postgres"

# Directus
DIRECTUS_KEY="directus_key"
DIRECTUS_SECRET="directus_secret"

# Network
CORS_ORIGIN="http://localhost:4200,http://model1.localhost:4201,http://model2.localhost:4201"
PUBLIC_URL="http://studio.localhost:8055"

# First admin (bootstrapped on first Directus start)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin12345"

# Storage: production uses self-hosted Garage (see compose.release.yaml).
# Local dev keeps Directus' default local filesystem storage, so no Garage
# variables are needed here. Production values are injected by the deploy
# workflow from GitHub secrets (GARAGE_BUCKET, GARAGE_ACCESS_KEY_ID,
# GARAGE_SECRET_ACCESS_KEY); the endpoint is fixed to http://garage:3900.
