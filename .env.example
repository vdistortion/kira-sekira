# Template for local environment. Copy to `.env` and fill in real values.
# Never commit the real `.env` — it contains secrets.

# Postgres
DB_PASSWORD=

# Directus
DIRECTUS_KEY=
DIRECTUS_SECRET=

# Network
CORS_ORIGIN=http://localhost:8055
PUBLIC_URL=http://localhost:8055

# First admin (bootstrapped on first Directus start)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Optional: Cloudflare R2 storage for local dev (point at the dev bucket).
# Leave blank to keep using local filesystem storage.
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=kira-sekira-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
